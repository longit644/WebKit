<UserControl
    x:Class="WebKitMiniBrowser.Views.Controls.BrowserAppBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Canvas.ZIndex="10">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BrowserDimOverlayBrush" Color="#80000000" />
        <SolidColorBrush x:Key="BrowserMenuHoverBrush" Color="#33808080" />
        <SolidColorBrush x:Key="BrowserMenuPressedBrush" Color="#66808080" />
        <ControlTemplate x:Key="BrowserMenuCommandTemplate" TargetType="Button">
            <Grid x:Name="MenuCommandSurface" Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <Storyboard>
                                <PointerUpThemeAnimation Storyboard.TargetName="MenuCommandContent" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <Storyboard>
                                <PointerUpThemeAnimation Storyboard.TargetName="MenuCommandContent" />
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCommandSurface"
                                                               Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrowserMenuHoverBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <PointerDownThemeAnimation Storyboard.TargetName="MenuCommandContent" />
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCommandSurface"
                                                               Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrowserMenuPressedBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCommandContent"
                                                               Storyboard.TargetProperty="Foreground">
                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                            Value="{ThemeResource AppBarButtonForegroundDisabled}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="MenuCommandContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </ControlTemplate>
        <Style x:Key="BrowserMenuItemStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template" Value="{StaticResource BrowserMenuCommandTemplate}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="AddressEditingOverlayElement" Canvas.ZIndex="10"
                Visibility="{Binding AddressEditingVisibility}"
                MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False"
                Command="{Binding CancelAddressEditingCommand}"
                AutomationProperties.Name="Dismiss address editing">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource BrowserDimOverlayBrush}" />
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid x:Name="MenuOverlayElement" Canvas.ZIndex="10" Visibility="Collapsed">
            <Grid.Clip>
                <RectangleGeometry x:Name="MenuOverlayClipElement" />
            </Grid.Clip>
            <Button Margin="0,0,0,48" MinWidth="0" MinHeight="0" Padding="0"
                    BorderThickness="0" Background="Transparent" IsTabStop="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Command="{Binding CloseMenuCommand}" AutomationProperties.Name="Dismiss actions">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource BrowserDimOverlayBrush}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border x:Name="MenuSheetElement" Margin="0,0,0,48"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    AutomationProperties.Name="Browser actions">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuSheetTranslationElement" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="MenuScrollElement" Grid.Row="0" Padding="0,4"
                                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button x:Name="ForwardMenuButtonElement" Style="{StaticResource BrowserMenuItemStyle}"
                                    Command="{Binding ForwardCommand}" AutomationProperties.Name="Forward">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16">
                                        <SymbolIcon Symbol="Forward" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Forward" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="DemoMenuButtonElement" Style="{StaticResource BrowserMenuItemStyle}"
                                    Command="{Binding LoadDemoCommand}" AutomationProperties.Name="Local demo">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16">
                                        <SymbolIcon Symbol="Home" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Local demo" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="MenuTopDividerElement" Grid.Row="0" Height="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top"
                            Background="{StaticResource BrowserMenuPressedBrush}" IsHitTestVisible="False" />
                    <Grid Grid.Row="1" Background="{ThemeResource AppBarBackground}">
                        <Grid x:Name="HelloActionHostElement" Width="68" HorizontalAlignment="Right">
                            <AppBarButton x:Name="HelloActionButtonElement" Icon="Contact" Label="Hello"
                                          IsCompact="False" UseSystemFocusVisuals="False"
                                          Command="{Binding HelloCommand}" />
                            <Border Width="16" Height="16" Margin="0,3,4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="8" Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                    Visibility="{Binding HelloNotificationVisibility}"
                                    IsHitTestVisible="False" AutomationProperties.Name="One new notification">
                                <TextBlock Text="1" FontSize="10" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
