<UserControl
    x:Class="WebKitMiniBrowser.Views.Controls.AddressBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Canvas.ZIndex="20"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- The default phone template forces ContentElement to Light when focused. -->
        <ControlTemplate x:Key="BrowserAddressInputTemplate" TargetType="TextBox">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver" />
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ScrollViewer x:Name="ContentElement" IsTabStop="False" ZoomMode="Disabled"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="PlaceholderTextContentPresenter" IsHitTestVisible="False"
                           Text="{TemplateBinding PlaceholderText}" Padding="{TemplateBinding Padding}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           Foreground="{TemplateBinding Foreground}" Opacity="0.65" />
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="AddressTapTargetTemplate" TargetType="Button">
            <Grid Background="Transparent" />
        </ControlTemplate>
        <ControlTemplate x:Key="BrowserCommandTemplate" TargetType="Button">
            <Grid x:Name="CommandSurface" Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CommandSurface"
                                                               Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                            Value="{ThemeResource AppBarButtonBackgroundPointerOver}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CommandSurface"
                                                               Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                            Value="{ThemeResource AppBarButtonBackgroundPressed}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CommandContent"
                                                               Storyboard.TargetProperty="Foreground">
                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                            Value="{ThemeResource AppBarButtonForegroundDisabled}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="CommandContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </ControlTemplate>
        <Style x:Key="BrowserChromeButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template" Value="{StaticResource BrowserCommandTemplate}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AddressLayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AddressStates">
                <VisualState x:Name="CompactAddress" />
                <VisualState x:Name="EditingAddress">
                    <VisualState.Setters>
                        <Setter Target="ChromeGrid.Background" Value="{ThemeResource BrowserEditSurfaceBrush}" />
                        <Setter Target="AddressInput.(Grid.Column)" Value="0" />
                        <Setter Target="AddressInput.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="AddressInput.Margin" Value="4" />
                        <Setter Target="AddressSurface.(Grid.Column)" Value="0" />
                        <Setter Target="AddressSurface.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="AddressSurface.Margin" Value="4" />
                        <Setter Target="AddressInput.IsHitTestVisible" Value="True" />
                        <Setter Target="AddressInput.IsTabStop" Value="True" />
                        <Setter Target="AddressInput.Padding" Value="6,0,6,0" />
                        <Setter Target="AddressInput.Foreground"
                                Value="{ThemeResource BrowserEditForegroundBrush}" />
                        <Setter Target="ReloadButton.Visibility" Value="Collapsed" />
                        <Setter Target="StopButton.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Collapsed" />
                        <Setter Target="AddressDivider.Visibility" Value="Collapsed" />
                        <Setter Target="AddressTapTarget.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="ChromeGrid" Height="48"
              Background="{ThemeResource AppBarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ReloadButton" Grid.Column="0" Style="{StaticResource BrowserChromeButtonStyle}"
                    Visibility="{Binding ReloadButtonVisibility}"
                    AutomationProperties.Name="Reload" ToolTipService.ToolTip="Reload"
                    Command="{Binding ReloadCommand}">
                <SymbolIcon Symbol="Refresh" />
            </Button>
            <Button x:Name="StopButton" Grid.Column="0" Style="{StaticResource BrowserChromeButtonStyle}"
                    Visibility="{Binding StopButtonVisibility}"
                    AutomationProperties.Name="Stop loading" ToolTipService.ToolTip="Stop loading"
                    Command="{Binding StopCommand}">
                <SymbolIcon Symbol="Cancel" />
            </Button>
            <Border x:Name="AddressSurface" Grid.Column="1" Margin="0,4" Canvas.ZIndex="1"
                    Background="{ThemeResource BrowserEditFieldBrush}"
                    Opacity="0" IsHitTestVisible="False" />
            <TextBox x:Name="AddressInput" Grid.Column="1" Margin="0,4" MinWidth="0" Canvas.ZIndex="2"
                      Padding="3,0,6,0" FontSize="15" HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                     Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                     Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Enter web address" InputScope="Url"
                      IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                      IsHitTestVisible="False" IsTabStop="False" Template="{StaticResource BrowserAddressInputTemplate}"
                     ToolTipService.ToolTip="{Binding DocumentTitle}"
                      AutomationProperties.Name="Web address" />
            <Button x:Name="AddressTapTarget" Grid.Column="1" Canvas.ZIndex="3" Style="{StaticResource BrowserChromeButtonStyle}"
                    Template="{StaticResource AddressTapTargetTemplate}"
                    Visibility="{Binding CompactChromeVisibility}"
                    Command="{Binding BeginAddressEditingCommand}" AutomationProperties.Name="Edit web address" />
            <Button x:Name="OverflowButton" Grid.Column="2" Style="{StaticResource BrowserChromeButtonStyle}"
                    Visibility="{Binding CompactChromeVisibility}"
                    AutomationProperties.Name="{Binding MenuButtonLabel}"
                    ToolTipService.ToolTip="{Binding MenuButtonLabel}"
                    Command="{Binding ToggleMenuCommand}">
                <SymbolIcon Symbol="More" />
            </Button>
            <Border x:Name="AddressDivider" Grid.Column="2" Width="1" Height="28"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.ZIndex="1"
                    Visibility="{Binding CompactChromeVisibility}" IsHitTestVisible="False"
                    Background="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
        </Grid>
    </Grid>
</UserControl>
