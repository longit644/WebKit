<Page
    x:Class="WebKitMiniBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:web="using:WebKit"
    xmlns:controls="using:WebKitMiniBrowser.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    IsTabStop="True" UseSystemFocusVisuals="False"
    KeyDown="OnPageKeyDown">

    <Grid>
        <!-- Web viewport follows system bars; IME motion belongs to the opaque edit/chrome layer. -->
        <Grid x:Name="WebLayoutRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>
            <!-- Engine paints opaque after first frame; page background avoids white flash in dark theme. -->
            <web:WebKitWebView x:Name="Browser" Grid.Row="0"
                               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
        <Grid x:Name="ShellRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              SizeChanged="OnShellRootSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="2" MinHeight="2"
                         VerticalAlignment="Bottom" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                         Background="Transparent" IsIndeterminate="True"
                         Visibility="{Binding LoadingVisibility}" />

            <controls:BrowserAppBarControl x:Name="BrowserAppBar" Grid.RowSpan="3" />
            <controls:AddressBarControl x:Name="AddressBar" Grid.Row="2" />
        </Grid>
    </Grid>
</Page>
