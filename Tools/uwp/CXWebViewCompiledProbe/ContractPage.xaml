<Page x:Class="WebKitCompiledProbe.ContractPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:web="using:WebKit" Background="#EDF3FA" RequestedTheme="Light">
    <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="M10 WebKit compiled contract" FontSize="26" Margin="0,0,0,12"/>
        <ContentControl x:Name="ViewHost">
            <web:WebKitWebView x:Name="View" Width="260" Height="100" Source="{x:Null}"/>
        </ContentControl>
        <web:WebKitWebView x:Name="SourceView" Width="260" Height="40" Source="https://example.test/compiled-target"/>
        <TextBlock x:Name="TitleBinding" Text="{Binding DocumentTitle, ElementName=View}"/>
        <Button x:Name="BackBinding" Content="Bound CanGoBack" IsEnabled="{Binding CanGoBack, ElementName=View}"/>
        <ProgressRing x:Name="LoadingBinding" IsActive="{Binding IsLoading, ElementName=View}" Width="24" Height="24"/>
        <TextBlock x:Name="Status" Text="Waiting for compiled Loaded..." FontSize="22" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
