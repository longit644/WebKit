<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" IgnorableNamespaces="uap">
    <Identity Name="WebKitProbe.SourceStateHost" Publisher="CN=WebKitWebView" Version="1.0.0.1" ProcessorArchitecture="arm"/>
    <Properties>
        <DisplayName>WebKit Source State Tests</DisplayName>
        <PublisherDisplayName>WebKitWebView</PublisherDisplayName>
        <Logo>Assets\probe.png</Logo>
    </Properties>
    <Dependencies>
        <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.15063.0" MaxVersionTested="10.0.19041.0"/>
        <PackageDependency Name="Microsoft.VCLibs.140.00" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" MinVersion="14.0.0.0"/>
    </Dependencies>
    <Resources><Resource Language="en-us"/></Resources>
    <Applications>
        <Application Id="App" Executable="SourceStateProbe.exe" EntryPoint="WebKitStateProbe.App">
            <uap:VisualElements DisplayName="WebKit Source State Tests" Description="M10 real control Source and observable-state verification"
                BackgroundColor="#303030" Square150x150Logo="Assets\probe.png" Square44x44Logo="Assets\probe.png"/>
        </Application>
    </Applications>
    <Extensions>
        <Extension Category="windows.activatableClass.inProcessServer">
            <InProcessServer>
                <Path>WebKit.dll</Path>
                <ActivatableClass ActivatableClassId="WebKit.WebKitWebView" ThreadingModel="both"/>
                <ActivatableClass ActivatableClassId="WebKit.WebKitWebViewOptions" ThreadingModel="both"/>
            </InProcessServer>
        </Extension>
    </Extensions>
</Package>
