<Page x:Class="CXCompileProbe.ProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:probe="using:WebKitProbe" Background="#EDF3FA" RequestedTheme="Light">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <TextBlock Text="M10 Compiled CX Probe (v6)" FontSize="28" Margin="0,0,0,16"/>
        <ContentControl x:Name="ProbeHost">
            <probe:XamlProbe x:Name="Probe" ProbeText="Compiled binding value" Width="240" Height="160"/>
        </ContentControl>
        <TextBlock x:Name="BoundText" Text="{Binding ProbeText, ElementName=Probe}" FontSize="20" Margin="0,16,0,0"/>
        <TextBlock x:Name="Status" Text="Waiting for Loaded..." FontSize="20" Margin="0,16,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="Details" Margin="0,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
