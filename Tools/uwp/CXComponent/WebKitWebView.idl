// WebKit.WebKitWebView component contract (v1). Design: design-winrt-component.md.
// Classic MIDLRT dialect (this toolchain's midlrt parses MIDL 1.0-style RT
// IDL): C-style enums, explicit get_/put_ methods, explicit event add_/remove_.
import "inspectable.idl";
import "EventToken.idl";
import "AsyncInfo.idl";
import "windows.ui.xaml.controls.idl";

namespace WebKit
{
    // Terminal outcome per navigation; exactly one fires per main-frame load.
    [version(1.0)]
    typedef enum WebKitNavigationOutcome
    {
        // Document committed and finished loading.
        Completed = 0,

        // Load failed; args carry the failing URL and error code.
        Failed = 1,

        // Superseded by a newer navigation or stopped; no page shown.
        Cancelled = 2
    } WebKitNavigationOutcome;

    // Custom delegates: sender is IInspectable (hosts QI for IWebKitWebView).
    // Classic MIDLRT rejects interface-typed sender params; verified by probe.
    // Terminal navigation notification for Completed, Failed and HistoryChanged.
    [uuid(331252db-3b4c-4011-b830-b7a34cc5b68c), version(1.0)]
    delegate HRESULT WebKitNavigationEventHandler(
        [in] IInspectable* sender,
        [in] IWebKitNavigationEventArgs* args);

    // Policy-time veto notification; the handler may set Cancel.
    [uuid(e2aaa8e0-f399-4a52-bc39-3f55669bec24), version(1.0)]
    delegate HRESULT WebKitNavStartingHandler(
        [in] IInspectable* sender,
        [in] IWebKitNavigationStartingEventArgs* args);

    // Commit-time URL notification for address-bar tracking.
    [uuid(7813f950-7875-4d1f-841d-b71419cc3865), version(1.0)]
    delegate HRESULT WebKitSourceChangedHandler(
        [in] IInspectable* sender,
        [in] IWebKitSourceChangedEventArgs* args);

    // C++ projection of the native wrapper: URL navigation, session
    // history, engine events and the policy-time veto. Single routed
    // instance per process; a second control refuses initialization.
    [uuid(da4dd758-dbf5-4568-8074-d92300fdb7b8), version(1.0)]
    interface IWebKitWebView : IInspectable
    {
        // Returns the last committed main-frame URL; fails before initialization.
        HRESULT get_Source([out, retval] HSTRING* value);

        // Starts an HTTP(S) navigation; unsupported schemes return E_INVALIDARG.
        HRESULT put_Source([in] HSTRING value);

        // Nonzero when session history has an entry behind the current one.
        HRESULT get_CanGoBack([out, retval] boolean* value);

        // Nonzero when session history has an entry ahead of the current one.
        HRESULT get_CanGoForward([out, retval] boolean* value);

        // Steps back in session history.
        HRESULT GoBack();

        // Steps forward in session history.
        HRESULT GoForward();

        // Re-requests the current document.
        HRESULT Reload();

        // Cancels the in-flight load.
        HRESULT Stop();

        // Shows app-supplied markup; never touches history.
        HRESULT NavigateToString([in] HSTRING html);

        // Ensures the engine is started; initial Source then navigates.
        HRESULT EnsureInitializedAsync(
            [out, retval] Windows.Foundation.IAsyncAction** operation);

        // Subscribes the policy-time veto event.
        HRESULT add_NavigationStarting(
            [in] WebKitNavStartingHandler* handler,
            [out, retval] EventRegistrationToken* token);

        // Unsubscribes the policy-time veto event.
        HRESULT remove_NavigationStarting([in] EventRegistrationToken token);

        // Subscribes the commit-time URL event.
        HRESULT add_SourceChanged(
            [in] WebKitSourceChangedHandler* handler,
            [out, retval] EventRegistrationToken* token);

        // Unsubscribes the commit-time URL event.
        HRESULT remove_SourceChanged([in] EventRegistrationToken token);

        // Subscribes the history-count-change event.
        HRESULT add_HistoryChanged(
            [in] WebKitNavigationEventHandler* handler,
            [out, retval] EventRegistrationToken* token);

        // Unsubscribes the history-count-change event.
        HRESULT remove_HistoryChanged([in] EventRegistrationToken token);

        // Subscribes the successful-load event.
        HRESULT add_NavigationCompleted(
            [in] WebKitNavigationEventHandler* handler,
            [out, retval] EventRegistrationToken* token);

        // Unsubscribes the successful-load event.
        HRESULT remove_NavigationCompleted([in] EventRegistrationToken token);

        // Subscribes to failed main-frame navigation; hosts may show their own
        // failure UI and load it through NavigateToString.
        HRESULT add_NavigationFailed(
            [in] WebKitNavigationEventHandler* handler,
            [out, retval] EventRegistrationToken* token);

        // Unsubscribes the failed-load event.
        HRESULT remove_NavigationFailed([in] EventRegistrationToken token);
    };

    // Fired synchronously during the engine policy check. Set Cancel to
    // refuse the navigation. Skipped for same-document traversals.
    [uuid(df4d11eb-659d-478d-a21e-f3a1b1ea0903), version(1.0)]
    interface IWebKitNavigationStartingEventArgs : IInspectable
    {
        // Target URI under policy review.
        HRESULT get_Uri([out, retval] HSTRING* value);

        // Navigation ID shared with this navigation's later events.
        HRESULT get_NavigationId([out, retval] UINT64* value);

        // Whether the host refused the navigation.
        HRESULT get_Cancel([out, retval] boolean* value);

        // Refuses the navigation when set before the handler returns.
        HRESULT put_Cancel([in] boolean value);
    };

    // Fired when the committed URL changes, including same-document ones.
    // Hosts follow this for the address bar, never the typed text.
    [uuid(1e12f19a-bd8e-4bf9-be0c-2f4de1534766), version(1.0)]
    interface IWebKitSourceChangedEventArgs : IInspectable
    {
        // Committed URL the host shows in the address bar.
        HRESULT get_Uri([out, retval] HSTRING* value);

        // False for same-document traversals and replaceState.
        HRESULT get_IsNewDocument([out, retval] boolean* value);
    };

    // Shared by Completed, Failed, and HistoryChanged. For HistoryChanged
    // only Url is meaningful (Outcome is Completed, ErrorCode is 0).
    [uuid(0d6aeba7-2b48-4508-9751-6b56cf1d64dc), version(1.0)]
    interface IWebKitNavigationEventArgs : IInspectable
    {
        // Finished or failed URL; the history position for HistoryChanged.
        HRESULT get_Url([out, retval] HSTRING* value);

        // Navigation ID matching the Starting event that opened it.
        HRESULT get_NavigationId([out, retval] UINT64* value);

        // Completed, Failed or Cancelled terminal outcome.
        HRESULT get_Outcome([out, retval] WebKitNavigationOutcome* value);

        // Engine error code; 0 on success.
        HRESULT get_ErrorCode([out, retval] INT32* value);
    };

    // Component-created policy payload carrying the target, ID and mutable veto.
    [version(1.0), threading(both), marshaling_behavior(agile)]
    runtimeclass WebKitNavigationStartingEventArgs
    {
        // Default projection exposing policy-time navigation data and Cancel.
        [default] interface IWebKitNavigationStartingEventArgs;
    };

    // Component-created commit payload used to update the host address bar.
    [version(1.0), threading(both), marshaling_behavior(agile)]
    runtimeclass WebKitSourceChangedEventArgs
    {
        // Default projection exposing the committed URI and document-change flag.
        [default] interface IWebKitSourceChangedEventArgs;
    };

    // Component-created payload for completion, failure and history notifications.
    [version(1.0), threading(both), marshaling_behavior(agile)]
    runtimeclass WebKitNavigationEventArgs
    {
        // Default projection exposing URL, navigation ID, outcome and error code.
        [default] interface IWebKitNavigationEventArgs;
    };

    // Activatable browser contract declaring a XAML UserControl base.
    // Events surface as add_/remove_ pairs (classic MIDLRT has no event
    // keyword in runtimeclass); projections bind them by naming convention.
    // Marshaling/threading match the UserControl base (agile/both per SDK).
    [version(1.0), activatable(1.0), threading(both), marshaling_behavior(agile)]
    runtimeclass WebKitWebView : Windows.UI.Xaml.Controls.UserControl
    {
        // Default browser projection for navigation, history and event subscriptions.
        [default] interface IWebKitWebView;
    };
}
