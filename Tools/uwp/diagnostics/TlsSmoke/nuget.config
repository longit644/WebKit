<?xml version="1.0" encoding="utf-8"?>
<!--
  Proof-project feed pinning: ignore machine-wide feeds (which reference a
  long-gone local source) and restore only from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
