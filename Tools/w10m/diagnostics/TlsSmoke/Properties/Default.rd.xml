<!--
  Default runtime directives for the TlsSmoke C# host. The host uses no
  reflection-driven serialization beyond the XAML compiler's own output, so
  the stock application-assembly directive suffices and keeps the ARM Release
  .NET Native compilation warning-free.
-->
<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <Assembly Name="*Application*" Dynamic="Required All" />
  </Application>
</Directives>
